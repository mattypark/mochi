{
  "manifest_version": 3,
  "name": "mochi — Substack draft reader",
  "version": "0.6.0",
  "description": "Reads the Substack editor and streams the draft to the mochi desktop pet on this machine. Sends nothing anywhere else.",
  "content_scripts": [
    {
      "matches": [
        "https://substack.com/*",
        "https://*.substack.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "mochi — reading your Substack draft"
  }
}
